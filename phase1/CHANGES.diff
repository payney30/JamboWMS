+
+let INVENTORY_PENDING_FILE = null;
+
+async function loadInventorySummary() {
+  const el = document.getElementById('invSummary');
+  try {
+    // Lightweight probe (1 row, any query) just to tell whether a catalog
+    // has ever been loaded — full browsing of the ~7k-row catalog isn't a
+    // goal of this tab, the upload/diff/apply flow below is the point.
+    const probe = await api('/inventory/search?limit=1&include_zero=true');
+    el.textContent = probe.length
+      ? 'A warehouse catalog is currently loaded. Upload a new export below to refresh it.'
+      : 'No warehouse catalog loaded yet — upload the export below to get started.';
+  } catch (e) {
+    el.textContent = '';
+  }
+}
+
+function onInventoryFileChosen() {
+  const input = document.getElementById('invFileInput');
+  const errEl = document.getElementById('invErr');
+  errEl.textContent = '';
+  if (!input.files || !input.files[0]) return;
+  INVENTORY_PENDING_FILE = input.files[0];
+  previewInventoryImport();
+}
+
+async function previewInventoryImport() {
+  const errEl = document.getElementById('invErr');
+  errEl.textContent = '';
+  if (!INVENTORY_PENDING_FILE) return;
+  const formData = new FormData();
+  formData.set('file', INVENTORY_PENDING_FILE);
+  document.getElementById('invSummary').textContent = 'Reading file and comparing against the current catalog…';
+  try {
+    const diff = await api('/admin/inventory/preview', {method: 'POST', body: formData});
+    renderInventoryDiff(diff);
+  } catch (e) {
+    errEl.textContent = e.message;
+    loadInventorySummary();
+  }
+}
+
+function renderInventoryDiff(diff) {
+  document.getElementById('invPreviewSection').style.display = 'block';
+  document.getElementById('invDiffSummary').textContent =
+    `${diff.added_count} new · ${diff.changed_count} changed · ${diff.removed_count} removed (deactivated, not deleted)`;
+
+  const fmtVal = v => (v === null || v === undefined || v === '') ? '—' : escapeHtml(String(v));
+  const addedHtml = diff.added.slice(0, 200).map(r =>
+    `<div>+ <strong>${escapeHtml(r.sku)}</strong> — ${escapeHtml(r.description)}</div>`).join('');
+  const changedHtml = diff.changed.slice(0, 200).map(r => {
+    const fieldDiffs = Object.entries(r.diffs || {}).map(([field, d]) =>
+      `${field}: ${fmtVal(d.old)} → ${fmtVal(d.new)}`).join(', ');
+    const reactivatedNote = r.reactivated ? (fieldDiffs ? ' · reactivated' : 'reactivated') : '';
+    return `<div>~ <strong>${escapeHtml(r.sku)}</strong> — ${escapeHtml(r.description)}${fieldDiffs ? ' — ' + fieldDiffs : ''}${reactivatedNote}</div>`;
+  }).join('');
+  const removedHtml = diff.removed.slice(0, 200).map(r =>
+    `<div>− <strong>${escapeHtml(r.sku)}</strong> — ${escapeHtml(r.description)} <span style="color:var(--ink-soft);">(will be deactivated)</span></div>`).join('');
+
+  const truncNote = (list, label) => list.length > 200
+    ? `<div style="color:var(--ink-soft);margin-top:4px;">…and ${list.length - 200} more ${label}.</div>` : '';
+
+  document.getElementById('invDiffDetail').innerHTML =
+    (addedHtml || changedHtml || removedHtml)
+      ? addedHtml + truncNote(diff.added, 'added') + changedHtml + truncNote(diff.changed, 'changed')
+        + removedHtml + truncNote(diff.removed, 'removed')
+      : '<div style="color:var(--ink-soft);">No differences from the current catalog.</div>';
+
+  document.getElementById('invSummary').textContent = 'Review the changes below, then apply.';
+}
+
+async function applyInventoryImport() {
+  const btn = document.getElementById('invApplyBtn');
