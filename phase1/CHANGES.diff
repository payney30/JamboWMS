+      <span><strong>${escapeHtml(s.sku)}</strong> — ${escapeHtml(s.description)} × ${s.qty_requested}</span>
+      ${editable ? `<button class="btn btn-ghost btn-sm" onclick="removeSuggestedSupply(${drawerState.woId}, ${s.id})">Remove</button>` : ''}
+    </div>`).join('');
+}
+
+function debouncedSupplySearch(){ clearTimeout(supplySearchTimer); supplySearchTimer = setTimeout(runSupplySearch, 300); }
+
+function onSupplyIncludeZeroChange(checked){
+  SUPPLY_INCLUDE_ZERO = checked;
+  runSupplySearch();
+}
+
+async function runSupplySearch(){
+  const input = document.getElementById('supplySearchInput');
+  const resultsEl = document.getElementById('supplySearchResults');
+  if (!input || !resultsEl) return;
+  const q = input.value.trim();
+  if (!q) { resultsEl.innerHTML = ''; SUPPLY_SEARCH_RESULTS = []; return; }
+  try {
+    const params = new URLSearchParams({q, include_zero: SUPPLY_INCLUDE_ZERO ? 'true' : 'false', limit: '20'});
+    const results = await api('/inventory/search?' + params.toString());
+    SUPPLY_SEARCH_RESULTS = results;
+    renderSupplySearchResults(results);
+  } catch (e) {
+    if (e.message !== 'session expired') {
+      resultsEl.innerHTML = `<p style="font-size:12px;color:var(--ink-soft);">Search failed: ${escapeHtml(e.message)}</p>`;
+    }
+  }
+}
+
+function renderSupplySearchResults(results){
+  const resultsEl = document.getElementById('supplySearchResults');
+  if (!resultsEl) return;
+  if (!results.length) {
+    resultsEl.innerHTML = '<p style="font-size:12px;color:var(--ink-soft);">No matches.</p>';
+    return;
+  }
+  // Index-based lookups into SUPPLY_SEARCH_RESULTS (not string literals
+  // interpolated into the onchange attribute) — a SKU/description with a
+  // quote in it would otherwise break the HTML parser, same class of bug
+  // as the print/JSON.stringify fix elsewhere in this file.
+  resultsEl.innerHTML = results.map((r, i) => {
+    let stockNote;
+    if (r.qty_on_hand === null || r.qty_on_hand === undefined) {
+      stockNote = ` <span style="color:#b5651d;">(stock unknown)</span>`;
+    } else if (r.qty_on_hand === 0) {
+      stockNote = ` <span style="color:#b5651d;">(0 on hand)</span>`;
+    } else {
+      stockNote = ` <span style="color:var(--ink-soft);">(${r.qty_on_hand} on hand)</span>`;
+    }
+    const checked = SUPPLY_SELECTED.some(s => s.sku === r.sku) ? 'checked' : '';
+    return `<label style="display:flex;align-items:center;gap:6px;font-weight:400;font-size:13px;padding:2px 0;">
+        <input type="checkbox" ${checked} onchange="toggleSupplySelectionByIndex(${i}, this.checked)">
+        <span><strong>${escapeHtml(r.sku)}</strong> — ${escapeHtml(r.description)}${stockNote}</span>
+      </label>`;
+  }).join('');
+}
+
+function toggleSupplySelectionByIndex(idx, checked){
+  const item = SUPPLY_SEARCH_RESULTS[idx];
+  if (!item) return;
+  if (checked) {
+    if (!SUPPLY_SELECTED.some(s => s.sku === item.sku)) {
+      SUPPLY_SELECTED.push({sku: item.sku, description: item.description, qty_requested: 1});
+    }
+  } else {
+    SUPPLY_SELECTED = SUPPLY_SELECTED.filter(s => s.sku !== item.sku);
+  }
+  renderSupplySelectedTray();
+}
+
+function renderSupplySelectedTray(){
+  const tray = document.getElementById('supplySelectedTray');
+  const btn = document.getElementById('supplyAddBtn');
+  if (!tray) return;
+  if (!SUPPLY_SELECTED.length) {
+    tray.innerHTML = '';
+    if (btn) btn.style.display = 'none';
+    return;
+  }
+  tray.innerHTML = '<div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:4px;">Selected</div>' +
+    SUPPLY_SELECTED.map((s, i) => `<div style="display:flex;align-items:center;gap:6px;font-size:13px;padding:2px 0;">
+        <span style="flex:1;"><strong>${escapeHtml(s.sku)}</strong> — ${escapeHtml(s.description)}</span>
+        <input type="number" min="1" value="${s.qty_requested}" style="width:56px;padding:2px 4px;" onchange="updateSupplySelectedQty(${i}, this.value)">
+        <button class="btn btn-ghost btn-sm" onclick="removeSupplySelection(${i})">✕</button>
+      </div>`).join('');
+  if (btn) btn.style.display = '';
+}
+
+function updateSupplySelectedQty(i, val){
+  const n = parseInt(val, 10);
+  if (SUPPLY_SELECTED[i]) SUPPLY_SELECTED[i].qty_requested = (Number.isFinite(n) && n > 0) ? n : 1;
+}
+
+function removeSupplySelection(i){
+  SUPPLY_SELECTED.splice(i, 1);
+  renderSupplySelectedTray();
+  // Re-render results so any still-visible checkbox for the removed
+  // item reflects the unchecked state without a network round-trip.
+  if (SUPPLY_SEARCH_RESULTS.length) renderSupplySearchResults(SUPPLY_SEARCH_RESULTS);
+}
+
+async function commitSuggestedSupplies(woId){
+  if (!SUPPLY_SELECTED.length) return;
+  const btn = document.getElementById('supplyAddBtn');
+  if (btn) btn.disabled = true;
+  try {
+    await api(`/work-orders/${woId}/suggested-supplies`, {
+      method: 'POST',
+      body: {items: SUPPLY_SELECTED.map(s => ({sku: s.sku, description: s.description, qty_requested: s.qty_requested}))},
+    });
+    SUPPLY_SELECTED = [];
+    SUPPLY_SEARCH_RESULTS = [];
+    const input = document.getElementById('supplySearchInput');
+    if (input) input.value = '';
+    const resultsEl = document.getElementById('supplySearchResults');
+    if (resultsEl) resultsEl.innerHTML = '';
+    showToast('Supplies added to work order.', 'ok');
+    await refreshDrawerAfterSupplyChange(woId);
+  } catch (e) {
+    if (e.message !== 'session expired') showToast('Could not add supplies: ' + e.message, 'err');
+    if (btn) btn.disabled = false;
+  }
+}
+
+async function removeSuggestedSupply(woId, supplyId){
+  try {
+    await api(`/work-orders/${woId}/suggested-supplies/${supplyId}`, {method: 'DELETE'});
+    showToast('Removed.', 'ok');
+    await refreshDrawerAfterSupplyChange(woId);
+  } catch (e) {
+    if (e.message !== 'session expired') showToast('Could not remove: ' + e.message, 'err');
+  }
+}
+
+// Re-fetches and re-renders the drawer in place after a supply add/
+// remove. Not a save — the WO's other fields are untouched, and we
+// still hold the edit lock (these actions are only reachable when
+// editable), so this always re-renders with an empty lock banner.
+async function refreshDrawerAfterSupplyChange(woId){
+  try {
+    const w = await api('/work-orders/' + woId);
+    renderWODrawer(w, '');
+  } catch (e) { /* best effort — drawer just keeps showing stale data */ }
+}
