+  const workerEl = document.getElementById('dWorker');
+  const workerVal = workerEl ? workerEl.value : '';
+
+  const payload = {
+    status,
+    status_note: statusNote,
+    new_note_text: document.getElementById('dNote').value || null,
+    new_note_type: 'work_note',
+  };
+  // Only include team_id if the tech actually picked one — reassignment
+  // here is an optional "wrong team, send it to the right one" action,
+  // not a default resend of the current team (unlike the status field,
+  // which always reflects a real current value either way).
+  if (teamVal) {
+    payload.team_id = parseInt(teamVal, 10);
+    payload.assign_note = assignNote;
+  } else if (workerVal) {
+    // Enhancement backlog Phase 21: assigning to a worker without also
+    // reassigning teams still has to send team_id — crud.assign_work_order
+    // requires it — so this resends the WO's current team unchanged.
+    payload.team_id = currentWoTeamId;
+  }
+  if (workerVal) {
+    payload.person_id = parseInt(workerVal, 10);
+  } else if (workerEl && !workerVal && teamVal) {
+    // Explicitly unassigning the worker (blank selected) while also
+    // reassigning teams — person_id=null clears it rather than leaving
+    // a stale assignment pointing at a worker on the old team.
+    payload.person_id = null;
+  }
+
+  try {
+    await api(`/work-orders/${id}/save`, {method:'POST', body:payload});
+    showToast('Work order saved.', 'ok');
+    drawerState.dirty = false;
+    closeDrawer(true);
+    load();
+  } catch (e) {
+    if (e.message !== 'session expired') showToast('Could not save: ' + e.message, 'err');
+    btn.disabled = false;
+    btn.textContent = 'Save changes';
+  }
 }
 
 if (TOKEN) boot();
